# eMRO System Configuration
EMRO_URL=https://emro.lionair.com/emro/Home.trax
EMRO_USERNAME=
EMRO_PASSWORD=

# Polling Interval in seconds (default: 60 seconds)
POLL_INTERVAL_SECONDS=60

# Location to filter
MONITOR_LOCATION=DM01

# Headless mode: false for first login (with 2FA Authenticator), true for background
HEADLESS=false

# Google Sheets Configuration
# The ID from your Google Sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=credentials.json

# Session storage directory (keeps 2FA cookies)
SESSION_DIR=./data/browser_session
